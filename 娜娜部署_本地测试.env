# 娜娜技术雷达 · 本地测试 .env 模板
# 用法：复制本文件为 .env（仓库根目录），填入真实值后本地跑 `python -m radar run`
# 注意：.env 已在 .gitignore 里，不会提交到 GitHub，安全

# ---- 天亿马 LLM（必填）----
LLM_BASE_URL=https://www.tokentym.com/v1
LLM_API_KEY=填_你的_天亿马_TYM_key
LLM_MODEL=deepseek-v4-flash
# 若天亿马默认思考导致超时，取消下一行注释：
# LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

# ---- TikHub（可选，不填只扫免费源 B站/GitHub/HF/HN/资讯 RSS）----
TIKHUB_API_KEY=

# ---- 站点名与署名（娜娜定制）----
RADAR_SITE_NAME=娜娜技术雷达
RADAR_SITE_BY=娜娜 · 嘉儿的家情报局
RADAR_EDITOR=娜娜

# ---- 成本估算（用于运行报告，非计费实际）----
LLM_PRICE_CNY_PER_M=4,16